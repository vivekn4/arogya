# ------------------------------------------------------------------
# Arogya backend — environment configuration
# Copy to .env and adjust. NEVER commit a real .env with secrets.
# ------------------------------------------------------------------

# Port the API listens on (Render sets this automatically).
PORT=3000

# AI provider: "openai-compatible" (default) or "anthropic".
# Default runs FREE with no signup via the keyless Pollinations text API.
AI_PROVIDER=openai-compatible

# API key for the provider. OPTIONAL for openai-compatible
# (Pollinations works keyless); REQUIRED for anthropic.
AI_API_KEY=

# Model to request from the provider.
# Defaults: "openai" for openai-compatible, "claude-sonnet-4-5" for anthropic.
AI_MODEL=

# Base URL of the OpenAI-compatible endpoint (provider = openai-compatible).
# "/chat/completions" is appended automatically if missing.
AI_BASE_URL=https://text.pollinations.ai/openai

# Max tokens per AI reply, and upstream timeout in milliseconds.
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=60000

# Comma-separated list of allowed frontend origins, e.g.
# FRONTEND_URL=https://arogya.onrender.com,https://www.arogya.example
# Leave empty to allow all origins (fine for local dev; the server logs a
# warning — set this before going live).
FRONTEND_URL=

# Per-IP rate limit for POST /api/chat: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Trust proxy hops for correct client IPs behind Render/Heroku-style hosts.
TRUST_PROXY=1
